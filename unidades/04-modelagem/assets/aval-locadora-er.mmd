    rger ---|"(1,1)"| FIL
    FIL ---|"(1,N)"| rman{"mantém"}
    rman ---|"(1,1)"| VEI
    CAT ---|"(1,N)"| rcla{"classifica"}
    rcla ---|"(1,1)"| VEI
    CLI ---|"(0,N)"| rrea{"realiza"}
    rrea ---|"(1,1)"| LOC
    FUN ---|"(0,N)"| rreg{"registra"}
    rreg ---|"(1,1)"| LOC
    LOC ---|"(1,N)"| rinc{"inclui"}
    rinc ---|"(0,N)"| VEI
    rinc --- avd(["valor_diária"])
    LOC ---|"(1,N)"| rgera{"gera"}
